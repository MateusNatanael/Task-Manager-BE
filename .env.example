# Server
PORT=3333
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskmanager?schema=public"

# Auth (JWT)
JWT_SECRET="task-manager-be-super-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="*"

# Storage (S3 / Cloudflare R2 - Presigned URLs)
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET_NAME=""
